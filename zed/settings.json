// Zed settings. Only overrides on top of Zed's defaults.
// Defaults: run `zed: open default settings` from the command palette.
{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "auto_install_extensions": {
    "catppuccin": true
  },
  "theme": "Catppuccin Frappé",
  "vim_mode": true,
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "terminal": {
    // Login shell is bash: `--login` sources ~/.profile, which sets up the Nix environment and fish.
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/bash",
        "args": ["--login"]
      }
    },
    "font_family": "JetBrainsMono Nerd Font",
    "button": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  }
}
