// Zed keymap. Only overrides and additions on top of Zed's default vim keymap.
// Defaults: run `zed: open default keymap` from the command palette.
[
  {
    // Window commands under the leader key: forwards to Zed's built-in `ctrl-w` bindings.
    "context": "VimControl && !menu",
    "bindings": {
      "space w": ["workspace::SendKeystrokes", "ctrl-w"]
    }
  },
  {
    // Pane navigation (mirrors nvim/tmux), docks and tab cycling.
    "context": "Dock || Terminal || VimControl || EmptyPane",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-e": "workspace::ToggleLeftDock",
      "ctrl-t": "workspace::ToggleBottomDock",
      "ctrl-y": "workspace::ToggleRightDock",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "escape": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "k j": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // Local leader.
      ", q": "pane::CloseActiveItem",
      ", w": "workspace::Save",

      // Leader.
      "space /": "workspace::NewSearch",
      "space ,": "tab_switcher::Toggle",
      "space c f": "editor::Format",

      // Search.
      "space s w": "workspace::NewSearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space s r": "editor::FindAllReferences",

      // Projects.
      "space p p": "projects::OpenRecent",
      "space p o": "outline_panel::ToggleFocus",
      "space p r": "projects::OpenRemote",

      // Buffers/tabs.
      "space b c": "pane::CloseAllItems",
      "space b p": "pane::TogglePinTab",

      // Tasks.
      "space t t": "task::Spawn",
      "space t r": "task::Rerun",

      // Toggles.
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",
      "space u b": "git::Blame"
    }
  }
]
